DATABASE_HOST=localhost
DATABASE_NAME=mork_rag
DATABASE_USER=mork_user
DATABASE_PASSWORD=mork_password
DATABASE_PORT=5432

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_long_random_secret_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

MISTRAL_API_URL=https://api.mistral.ai/v1
MISTRAL_API_KEY=your_key_here

# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Writable path where uploaded ingest files are stored. In Docker use an
# absolute path under /app (or a mounted volume for persistence).
DATA_PATH=./data/data.metta
CHROMA_PATH=./chroma_store
